import "lib:math.lum" as math

if (@main){
    set i to 0
    show(i)
    i++
    show(i)
    show(math.pi)
    show(math.cos(math.pi))
    if (math.cos(math.pi) == -1.0){
        show("hello")
    }
    show(true == true)
    show(false == false)

    set lst to []
    show(lst)
    lst.add(123)
    lst.add("gagagag")
    show(lst)
    lst.clear()
    show(lst)
    show(@file)
    show(@main)
}