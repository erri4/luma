function fibonacci (num){
    if (num <= 0){
        return 0
    }
    set count to 2
    set a to 1
    set b to 1
    while (count < num){
        set b to a + b
        set a to b - a
        set count to count + 1
    }
    return b
}


// 0 1 2 3 4 5 6 7  ...
// 0 1 1 2 3 5 8 13 ...
set n to input ("hh")
set result to str (fibonacci (n))
show ("The " + str (n) + "th Fibonacci number is: " + result)