import lib:math.lum as math


function fib (n){
    if (n <= 2){
        return 1
    }

    return fib (n - 1) + fib (n - 2)
}

class customerr (BaseError) {
    constructor customerr (msg){
        show ("hi")
    }
}

//show (fib (10))
set i to 0
while (i < 10){
    if (i == 5){
        throw (customerr ("test"))
    }
    set i to i + 1
    show (i)
}
