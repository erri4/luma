set dct to {0: "g", 1: "h"}
show (dct.at (1))
dct.set (1, "t")
show (dct.at (1))
show (dct.at (0))
show (dct)
show (dct.len ())
set lst to ["hi"]
show (lst.at (0))
lst.add ("hello")
show (lst)
function test (cls){
    cls ()
}

class test2 {
    constructor test2 (){
        show ("hi")
    }
}

test (test2)
show (&test2)
show (&test)