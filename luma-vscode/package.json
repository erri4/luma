{
  "name": "luma",
  "displayName": "luma",
  "description": "luma language support",
  "version": "0.1.0",
  "icon": "luma.png",
  "publisher": "Erri4",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "luma",
      "aliases": ["luma"],
      "extensions": [".lum"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/luma.png",
        "dark": "./icons/luma.png"
      }
    }],
    "iconThemes": [
      {
        "id": "luma-icons",
        "label": "Luma File Icons",
        "path": "./file-icon-theme.json"
      }
    ],
    "grammars": [{
      "language": "luma",
      "scopeName": "source.luma",
      "path": "./syntaxes/luma.tmLanguage.json"
    }],
    "taskDefinitions": [{
      "type": "luma"
    }]
  }
}