class raw {
    constructor raw (){

    }
}


class valuedObject {
    constructor valuedObject (value){
        set this.value to value
    }

    function @stringify (){
        return nativecode (r"str(" + packvalue (this.value) + r")")
    }
}

class str (valuedObject) {
    constructor str (value){
        set this.value to nativecode (r"str(" + packvalue (value) + r")")
    }

    function len (){
        return int (nativecode (r"len(" + packvalue (this.value) + r")"))
    }

    function @addition (other){
        return str (this.value + str (other).value)
    }

    function @multiplication (other){
        return str (nativecode (packvalue (this.value) + r" * " + packvalue (other.value)))
    }
}

class int (valuedObject) {
    constructor int (value){
        set this.value to nativecode (r"int(" + packvalue (value) + r")")
    }

    function len (){
        return int (nativecode (r"len(" + packvalue (this.value) + r")"))
    }

    function @addition (other){
        if (&other == &this){
            return int (nativecode (str (this.value).value + r" + " + str (other).value))
        }
        return float (nativecode (str (this.value).value + r" + " + str (other).value))
    }

    function @division (other){
        return float (nativecode (str (this.value).value + r" / " + str (other).value))
    }

    function @subtraction (other){
        if (&other == &this){
            return int (nativecode (str (this.value).value + r" - " + str (other).value))
        }
        return float (nativecode (str (this.value).value + r" - " + str (other).value))
    }

    function @multiplication (other){
        if (&other == &this){
            return int (nativecode (str (this.value).value + r" * " + str (other).value))
        }
        return float (nativecode (str (this.value).value + r" * " + str (other).value))
    }
}

class float (valuedObject) {
    constructor float (value){
        set this.value to nativecode (r"float(" + packvalue (value) + r")")
    }

    function @addition (other){
        return float (nativecode (str (this.value).value + r" + " + other.value))
    }

    function @division (other){
        return float (nativecode (str (this.value).value + r" / " + other.value))
    }

    function @subtraction (other){
        return float (nativecode (str (this.value).value + r" - " + other.value))
    }

    function @multiplication (other){
        return float (nativecode (str (this.value).value + r" * " + other.value))
    }
}

class dict (valuedObject) {
    function at (pos) {
        return nativecode (str (this.value) + "[" + packvalue (pos) + "]")
    }

    function set (pos, value) {

    }
}

function range (start, end, jump){

}

function show (data = "", end = "\n"){
    nativecode ("print(" + str (packvalue (str (data))) + ", end=" + str (packvalue (str (end))) + ")")
}

function input (prompt = ""){
    set inpt to str (nativecode ("input(" + str (packvalue (str (prompt))) + ")"))
    return inpt
}

set @file to str (nativecode ("filename"))
