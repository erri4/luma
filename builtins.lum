class valuedObject {
    constructor valuedObject (value){
        set this.value to value
    }

    function @stringify (){
        return nativecode (r$str(val)$, {r$val$: this.value})
    }

    function len (){
        return new int (nativecode (r$len($ + packvalue (this.value) + r$)$))
    }
}

class str (valuedObject) {
    constructor str (value){
        set this.value to nativecode (r$str($ + packvalue (value) + r$)$)
    }

    function @bool (){
        return new bool (nativecode (r$bool($ + packvalue (this.value) + r$)$))
    }

    function @equal (other){
        return new bool (nativecode (packvalue (this.value) + r$ == $ + packvalue (new str (other.value).value)))
    }

    function @nequal (other){
        return new bool (nativecode ("thisval != otherval", {"thisval": this.value, "otherval": other.value}))
    }

    function @addition (other){
        return new str (this.value + new str (other).value)
    }

    function @multiplication (other){
        return new str (nativecode (packvalue (this.value) + r$ * $ + packvalue (other.value)))
    }

    function @repr (){
        return new str (nativecode ("reprify (thisval)", {"thisval": this.value}))
    }
}

class int (valuedObject) {
    constructor int (value){
        set this.value to nativecode (r$int($ + packvalue (value) + r$)$)
    }

    function @bool (){
        return new bool (nativecode (r$bool($ + new str (this.value).value + r$)$))
    }

    function @equal (other){
        return new bool (nativecode ("thisval == otherval", {"thisval": this.value, "otherval": other.value}))
    }

    function @nequal (other){
        return new bool (nativecode ("thisval != otherval", {"thisval": this.value, "otherval": other.value}))
    }

    function @lequal (other){
        return new bool (nativecode (new str (this.value).value + r$ <= $ + new str (other.value).value))
    }

    function @lesst (other){
        return new bool (nativecode ("thisval < otherval", {"thisval": this.value, "otherval": other.value}))
    }

    function @greatert (other){
        return new bool (nativecode (new str (this.value).value + r$ > $ + new str (other.value).value))
    }

    function @gequal (other){
        return new bool (nativecode (new str (this.value).value + r$ <= $ + new str (other.value).value))
    }

    function @addition (other){
        if (&other == int){
            return new int (nativecode ("thisval + otherval", {"thisval": this.value, "otherval": other.value}))
        }
        return new float (nativecode ("thisval + otherval", {"thisval": this.value, "otherval": other.value}))
    }

    function @division (other){
        return new float (nativecode (new str (this.value).value + r$ / $ + new str (other).value))
    }

    function @subtraction (other){
        if (&other == int){
            return new int (nativecode (new str (this.value).value + r$ - $ + new str (other).value))
        }
        return new float (nativecode (new str (this.value).value + r$ - $ + new str (other).value))
    }

    function @multiplication (other){
        if (&other == int){
            return new int (nativecode (new str (this.value).value + r$ * $ + new str (other).value))
        }
        return new float (nativecode (new str (this.value).value + r$ * $ + new str (other).value))
    }

    function @repr (){
        return new str (this.value)
    }
}

class float (valuedObject) {
    constructor float (value){
        set this.value to nativecode (r$float($ + packvalue (value) + r$)$)
    }

    function @addition (other){
        return new float (nativecode (new str (this.value).value + r$ + $ + other.value))
    }

    function @division (other){
        return new float (nativecode (new str (this.value).value + r$ / $ + other.value))
    }

    function @subtraction (other){
        return new float (nativecode (new str (this.value).value + r$ - $ + other.value))
    }

    function @multiplication (other){
        return new float (nativecode (new str (this.value).value + r$ * $ + other.value))
    }

    function @repr (){
        return new str (this.value)
    }
}

class list (dict) {
    function add (value){
        this.set (this.len (), value)
    }

    function @stringify (){
        set r to "["
        set i to 0
        while (i < this.len ()){
            if (i == this.len () - 1){
                set r to r + (this.at (i)).@repr ()
            }
            else {
                set r to r + this.at (i).@repr () + ", "
            }
            set i to i + 1
        }
        set r to r + "]"
        return r
    }

    function @repr (){
        return new str (this)
    }
}

function range (start = 0, end, jump = 1){
    // NOTE: implement this
    // also overload
    set r to []
    set i to start
    while (i < end){
        r.add (i)
        set i to i + jump
    }
    return r
}

function show (data = "", end = "\n"){
    nativecode ("print(data, end=str(endchar))", {"data": new str (data), "endchar": end})
}

function input (prompt = ""){
    set inpt to new str (nativecode ("input(prompt)", {"prompt": prompt}))
    return inpt
}

