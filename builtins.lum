class valuedObject {
    constructor valuedObject (value){
        set this.value to value
    }

    function @stringify (){
        return nativecode (r"str(" + packstr (this.value) + r")")
    }
}

class str (valuedObject) {
    constructor str (value){
        set this.value to nativecode (r"str(" + packstr (value) + r")")
    }

    function @addition (other){
        return str (this.value + str (other).value)
    }

    function @multiplication (other){
        return str (nativecode (packstr (this.value) + r" * " + other.value))
    }
}

class int (valuedObject) {
    constructor int (value){
        set this.value to nativecode (r"int(" + packstr (value) + r")")
    }

    function @addition (other){
        return int (nativecode (this.value + r" + " + other.value))
    }

    function @division (other){
        return float (nativecode (this.value + r" / " + other.value))
    }

    function @subtraction (other){
        return int (nativecode (this.value + r" - " + other.value))
    }

    function @multiplication (other){
        return int (nativecode (this.value + r" * " + other.value))
    }
}

class float (valuedObject) {
    constructor float (value){
        set this.value to nativecode (r"float(" + packstr (value) + r")")
    }

    function @addition (other){
        return float (nativecode (this.value + r" + " + other.value))
    }

    function @division (other){
        return float (nativecode (this.value + r" / " + other.value))
    }

    function @subtraction (other){
        return float (nativecode (this.value + r" - " + other.value))
    }

    function @multiplication (other){
        return float (nativecode (this.value + r" * " + other.value))
    }
}

