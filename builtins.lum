function show (data){
    nativecode ("print(" + str (packstr (str (data))) + ")")
}

function input (prompt){
    set inpt to str (nativecode ("input(" + str (packstr (str (prompt))) + ")"))
    return inpt
}

set @file to str (nativecode ("filename"))
